# --- api/ (Railway service variables) ---

# Keys clients use to call the API (comma-separated). Empty = no auth (dev only).
DAVID_API_KEYS=change-me

# Model API. Phase 0: OpenRouter (the default LLM_BASE_URL).
LLM_API_KEY=sk-or-...
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LLM_TIMEOUT=300

# Gateway + harness
RATE_LIMIT_RPM=60        # per API key; 0 = off
MAX_TOOL_ROUNDS=5        # model calls per request
MAX_REPAIRS=1            # failed validations the model may fix per request

# --- Phase 1 only: self-hosted SGLang on Modal ---
# Option A: set the URL directly (printed by `modal deploy`).
# LLM_BASE_URL=https://...modal.run/v1
# Option B: set LLM_BASE_URL= (empty) and let the Modal SDK resolve it:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# DAVID_MODAL_APP=david-sglang
# Modal proxy token (wk-xxx.ws-yyy), sent as Bearer when LLM_API_KEY is unset.
# MODAL_PROXY_TOKEN=
# LLM_MODEL=Qwen/Qwen3-8B-AWQ
# ENABLE_THINKING=false
